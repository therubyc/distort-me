{
  "manifestVersion": 5,
  "id": "com.therubyc.distortme",
  "name": "Distort Me",
  "version": "0.3.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "distortme",
      "label": { "default": "Distort Me" },
      "minimumSize": { "width": 300, "height": 520 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 980 },
      "preferredFloatingSize": { "width": 360, "height": 980 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
